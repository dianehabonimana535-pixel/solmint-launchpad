# --- IPFS (Pinata) ---
# Create a free account at https://pinata.cloud, then generate a JWT under
# API Keys with "pinFileToIPFS" and "pinJSONToIPFS" permissions.
# This stays server-side only (used in app/api/upload/route.ts) and is
# never exposed to the browser.
PINATA_JWT=

# Optional: custom Pinata gateway domain (defaults to gateway.pinata.cloud)
PINATA_GATEWAY=gateway.pinata.cloud

# --- Solana RPC ---
# Public mainnet RPC is heavily rate-limited. For production, use a paid
# RPC provider: Helius, QuickNode, Triton, Alchemy, etc.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
